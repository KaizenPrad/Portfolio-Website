{
  "name": "pradyumn-dwivedi-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Premium dark-editorial portfolio website for Pradyumn Dwivedi — Full-Stack Developer.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview --port 4173",
    "lint": "oxlint",
    "assets:projects": "node scripts/prepare-project-images.mjs",
    "assets:profile": "node scripts/remove-bg-ai.mjs public/images/profile-source.jpg public/images/profile-cutout.png && node scripts/finalize-profile.mjs public/images/profile-cutout.png",
    "assets:og": "node scripts/og-image.mjs",
    "assets:noise": "node scripts/make-noise.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "sharp@0.35.5": true
  }
}
